{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "TZ"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    // Workspace packages ship TypeScript source, so a package's lint, typecheck and unit tests
    // read its dependencies' source. This no-script "transit" task puts the dependencies' hashes
    // into theirs, so a change in core invalidates the cache of integrations, without making
    // the tasks wait for each other.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["test:unit", "test:integration"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
