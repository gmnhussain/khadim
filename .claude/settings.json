{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.development)",
      "Read(/**/.env.production)",
      "Read(/**/.env.staging)",
      "Read(/**/.env.test)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Read(/**/credentials*.json)",
      "Read(/**/*service-account*.json)"
    ]
  }
}
